# Writes OUTPUT, a C++ source holding the translations of LANGUAGES
# (codes separated by commas) from TRANSLATIONS/<code>/LC_MESSAGES/resend.po.
# Bytes rather than string literals: some compilers limit their length.
string(REPLACE "," ";" codes "${LANGUAGES}")
set(arrays "")
set(entries "")
foreach(code IN LISTS codes)
    file(READ "${TRANSLATIONS}/${code}/LC_MESSAGES/resend.po" bytes HEX)
    string(LENGTH "${bytes}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${bytes}")
    string(MAKE_C_IDENTIFIER "${code}" name)
    string(APPEND arrays "constexpr char po_${name}[] = {${bytes}};\n")
    string(APPEND entries "    {\"${code}\", std::string_view(po_${name}, ${size})},\n")
endforeach()
file(WRITE "${OUTPUT}.new" "// Generated by cmake/embed_catalogs.cmake from translations/: do not edit.
#include \"core/catalogs.hpp\"

namespace netsim::text {
namespace {
${arrays}
constexpr BuiltInCatalog all[] = {
${entries}};
} // namespace

std::span<const BuiltInCatalog> built_in_catalogs() { return all; }

} // namespace netsim::text
")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
