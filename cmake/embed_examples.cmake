# Writes OUTPUT, a C++ source holding the example scenarios of SOURCE_DIR
# in the order of EXAMPLES (names separated by commas), for the app's menu.
string(REPLACE "," ";" names "${EXAMPLES}")
set(body "")
foreach(name IN LISTS names)
    file(READ "${SOURCE_DIR}/${name}" text)
    string(FIND "${text}" ")example\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${name} contains the raw string delimiter )example\"")
    endif()
    string(APPEND body "    {\"${name}\", R\"example(${text})example\"},\n")
endforeach()
file(WRITE "${OUTPUT}.new" "// Generated by cmake/embed_examples.cmake from examples/: do not edit.
#include \"app/examples.hpp\"

namespace resend {
namespace {
constexpr Example all[] = {
${body}};
} // namespace

std::span<const Example> examples() { return all; }

} // namespace resend
")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
