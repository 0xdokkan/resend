# Writes OUTPUT, a C++ source holding the labs of SOURCE_DIR in the order of
# LABS (names separated by commas), for the app's library. Each file is cut
# into pieces under MSVC's limit for one string literal.
string(REPLACE "," ";" names "${LABS}")
set(body "")
foreach(name IN LISTS names)
    file(READ "${SOURCE_DIR}/${name}" text)
    string(FIND "${text}" ")lab\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${name} contains the raw string delimiter )lab\"")
    endif()
    string(LENGTH "${text}" size)
    set(pieces "")
    set(at 0)
    while(at LESS size)
        string(SUBSTRING "${text}" ${at} 8000 piece)
        string(APPEND pieces "R\"lab(${piece})lab\"\n        ")
        math(EXPR at "${at} + 8000")
    endwhile()
    string(APPEND body "    {\"${name}\",\n        ${pieces}},\n")
endforeach()
file(WRITE "${OUTPUT}.new" "// Generated by cmake/embed_labs.cmake from labs/: do not edit.
#include \"app/labs.hpp\"

namespace resend {
namespace {
constexpr LabFile all[] = {
${body}};
} // namespace

std::span<const LabFile> lab_files() { return all; }

} // namespace resend
")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
