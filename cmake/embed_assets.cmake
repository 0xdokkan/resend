# Writes OUTPUT, a C++ source holding the text assets of SOURCE_DIR that the
# look of the app is drawn from: palettes.json, the sprite legend and the
# sheets named in SHEETS (names separated by commas, under sprites/).
function(raw_literal path out)
    file(READ "${path}" text)
    string(FIND "${text}" ")asset\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${path} contains the raw string delimiter )asset\"")
    endif()
    set(${out} "R\"asset(${text})asset\"" PARENT_SCOPE)
endfunction()

raw_literal("${SOURCE_DIR}/palettes.json" palettes)
raw_literal("${SOURCE_DIR}/sprites/legend.txt" legend)
string(REPLACE "," ";" names "${SHEETS}")
set(sheets "")
foreach(name IN LISTS names)
    raw_literal("${SOURCE_DIR}/sprites/${name}" text)
    string(APPEND sheets "    {\"${name}\", ${text}},\n")
endforeach()
file(WRITE "${OUTPUT}.new" "// Generated by cmake/embed_assets.cmake from assets/: do not edit.
#include \"look/look.hpp\"

namespace resend::look {
namespace {
constexpr SheetText sheets[] = {
${sheets}};
} // namespace

std::span<const SheetText> sheet_texts() { return sheets; }
std::string_view legend_text() { return ${legend}; }
std::string_view palettes_text() { return ${palettes}; }

} // namespace resend::look
")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
