import { LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { Theme, Geometry } from "theme.slint";
import { Action, Caption, Chip, DeviceIcon, Divider, PanelHeader } from "widgets.slint";
import { UiCanvas, Canvas, NodeView, LinkView, PacketView, MarkerView } from "canvas.slint";
import { UiInspector, Inspector, PortView, RouteView } from "inspector.slint";
import { UiTimeline, TimelinePanel, EventView } from "timeline.slint";
import { UiFrame, FieldRow, HexByte, HexRow } from "frame.slint";
import { UiApp, UiRun, ExampleView, LanguageView, FileView } from "state.slint";
import { FileDialog, ConfirmDialog, AboutDialog } from "dialogs.slint";

export { Geometry, UiCanvas, UiInspector, UiTimeline, UiFrame, UiApp, UiRun }
export { NodeView, LinkView, PacketView, MarkerView, PortView, RouteView, EventView, FieldRow, HexByte, HexRow, ExampleView, LanguageView, FileView }

component DeviceChoice inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> kind;
    callback clicked();
    height: 64px;
    border-radius: 9px;
    background: touch.has-hover ? #1e2e3d : #172331;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.mint : touch.has-hover ? #42655e : Theme.line;
    accessible-role: button;
    accessible-label: @tr("Add {0}", root.title);
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    DeviceIcon { x: 12px; y: 12px; width: 27px; height: 26px; kind: root.kind; }
    Text { x: 50px; y: 13px; text: root.title; color: Theme.ink; font-size: 14px; font-weight: 600; }
    Text { x: 50px; y: 34px; width: parent.width - 60px; text: root.subtitle; color: Theme.muted; font-size: 10px; overflow: elide; }
    Text { x: parent.width - 22px; y: 12px; text: "+"; color: Theme.muted; font-size: 18px; }
    focus := FocusScope {
        focus-on-tab-navigation: true;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

// Devices to add and the lesson that comes with the network.
component PaletteView inherits Rectangle {
    callback fold();
    background: Theme.panel;
    VerticalLayout {
        PanelHeader {
            title: @tr("Build");
            fold-text: @tr("Hide the palette");
            fold => { root.fold(); }
        }
        VerticalLayout {
            padding-left: 14px; padding-right: 14px; padding-bottom: 14px;
            spacing: 8px;
            DeviceChoice { title: @tr("Host"); subtitle: @tr("IPv4 · 1 Ethernet port"); kind: "host"; clicked => { UiApp.add-device("host"); } }
            DeviceChoice { title: @tr("Switch"); subtitle: @tr("Layer 2 · 8 ports"); kind: "switch"; clicked => { UiApp.add-device("switch"); } }
            DeviceChoice { title: @tr("Router"); subtitle: @tr("IPv4 · 2 to 8 ports"); kind: "router"; clicked => { UiApp.add-device("router"); } }
            Text {
                text: @tr("Drag a card to move it. Drag from a port light or from + to another card to plug a cable.");
                color: Theme.muted; font-size: 10px; wrap: word-wrap;
            }
            Divider { }
            Caption { text: @tr("LESSON"); }
            Text { text: UiApp.title == "" ? @tr("Your own network") : UiApp.title; color: Theme.ink; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    alignment: start;
                    Text {
                        text: UiApp.notes == "" ? @tr("Build a network, send a ping and follow every frame. Examples in the File menu come with a lesson.") : UiApp.notes;
                        color: Theme.muted; font-size: 11px; wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// A folded side panel: a strip with the button that opens it again.
component FoldedPanel inherits Rectangle {
    in property <string> text;
    in property <string> symbol;
    callback unfold();
    width: 32px;
    background: Theme.panel;
    VerticalLayout {
        padding-top: 8px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Action { text: root.symbol; accessible-text: root.text; quiet: true; small: true; width: 26px; clicked => { root.unfold(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: UiApp.document + (UiApp.modified ? " •" : "") + " — resend";
    preferred-width: 1360px;
    preferred-height: 900px;
    // No minimum of its own: the panels' set it, and folding them lets the
    // window shrink, down to 960 × 540 for a 1080p screen at 2× scale.
    background: Theme.base;
    default-font-family: "Inter";
    default-font-size: 13px;

    // Gives the keyboard to the canvas.
    public function focus-canvas() { canvas.take-focus(); }

    // The canvas has the keyboard at start and again when a dialog closes,
    // so the shortcuts, which come from it, keep working.
    property <string> dialog: UiApp.dialog;
    changed dialog => { if self.dialog == "" { canvas.take-focus(); } }
    init => {
        Palette.color-scheme = ColorScheme.dark;
        canvas.take-focus();
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New"); activated => { UiApp.new-document(); } }
            MenuItem { title: @tr("Open…"); activated => { UiApp.open-document(); } }
            Menu {
                title: @tr("Open example");
                for example[i] in UiApp.examples: MenuItem { title: example.title; activated => { UiApp.open-example(i); } }
            }
            MenuSeparator { }
            MenuItem { title: @tr("Save"); activated => { UiApp.save(); } }
            MenuItem { title: @tr("Save as…"); activated => { UiApp.save-as(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Quit"); activated => { UiApp.quit(); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: UiApp.undo-text; enabled: UiApp.can-undo; activated => { UiApp.undo(); } }
            MenuItem { title: UiApp.redo-text; enabled: UiApp.can-redo; activated => { UiApp.redo(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Add host"); activated => { UiApp.add-device("host"); } }
            MenuItem { title: @tr("Add switch"); activated => { UiApp.add-device("switch"); } }
            MenuItem { title: @tr("Add router"); activated => { UiApp.add-device("router"); } }
            MenuItem { title: @tr("Delete selection"); activated => { UiApp.delete-selection(); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Fit the network in view"); activated => { UiCanvas.fit(); } }
            MenuItem { title: @tr("Zoom in"); activated => { UiCanvas.zoom-by(1.15); } }
            MenuItem { title: @tr("Zoom out"); activated => { UiCanvas.zoom-by(1 / 1.15); } }
            MenuItem { title: @tr("Actual size"); activated => { UiCanvas.reset-zoom(); } }
            MenuSeparator { }
            MenuItem { title: @tr("Palette"); checkable: true; checked: UiApp.palette-open; activated => { UiApp.palette-open = !UiApp.palette-open; } }
            MenuItem { title: @tr("Inspector"); checkable: true; checked: UiApp.inspector-open; activated => { UiApp.inspector-open = !UiApp.inspector-open; } }
            MenuItem { title: @tr("Timeline"); checkable: true; checked: UiApp.timeline-open; activated => { UiApp.timeline-open = !UiApp.timeline-open; } }
            MenuItem { title: @tr("Reduce motion"); checkable: true; checked: UiApp.reduced-motion; activated => { UiApp.toggle-motion(); } }
            MenuSeparator { }
            Menu {
                title: @tr("Language");
                MenuItem { title: @tr("As the system"); checkable: true; checked: UiApp.language == ""; activated => { UiApp.set-language(""); } }
                for language in UiApp.languages: MenuItem {
                    title: language.name;
                    checkable: true;
                    checked: UiApp.language == language.code;
                    activated => { UiApp.set-language(language.code); }
                }
            }
        }
        Menu {
            title: @tr("Simulation");
            MenuItem { title: UiRun.running ? @tr("Pause") : @tr("Run"); enabled: UiRun.pending; activated => { UiRun.run-toggle(); } }
            MenuItem { title: @tr("Step"); enabled: UiRun.pending && !UiRun.running; activated => { UiRun.step(); } }
            MenuItem { title: @tr("Go to the latest instant"); activated => { UiRun.latest(); } }
            MenuItem { title: @tr("Reset"); activated => { UiRun.reset(); } }
            Menu {
                title: @tr("Speed");
                MenuItem { title: "0.25×"; checkable: true; checked: UiRun.speed == 0.25; activated => { UiRun.set-speed(0.25); } }
                MenuItem { title: "0.5×"; checkable: true; checked: UiRun.speed == 0.5; activated => { UiRun.set-speed(0.5); } }
                MenuItem { title: "1×"; checkable: true; checked: UiRun.speed == 1; activated => { UiRun.set-speed(1); } }
                MenuItem { title: "2×"; checkable: true; checked: UiRun.speed == 2; activated => { UiRun.set-speed(2); } }
                MenuItem { title: "4×"; checkable: true; checked: UiRun.speed == 4; activated => { UiRun.set-speed(4); } }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("About resend"); activated => { UiApp.about(); } }
        }
    }

    // Shortcuts: keys the focused control does not use come here.
    shortcuts := FocusScope {
        key-pressed(e) => {
            if !(e.modifiers.control || e.modifiers.meta) || UiApp.dialog != "" { return reject; }
            if e.text == "z" || e.text == "Z" {
                if e.modifiers.shift { UiApp.redo(); } else { UiApp.undo(); }
                return accept;
            }
            if e.text == "y" || e.text == "Y" { UiApp.redo(); return accept; }
            if e.text == "s" || e.text == "S" {
                if e.modifiers.shift { UiApp.save-as(); } else { UiApp.save(); }
                return accept;
            }
            if e.text == "o" || e.text == "O" { UiApp.open-document(); return accept; }
            if e.text == "n" || e.text == "N" { UiApp.new-document(); return accept; }
            if e.text == "q" || e.text == "Q" { UiApp.quit(); return accept; }
            return reject;
        }

        VerticalLayout {
            // The document and undo.
            Rectangle {
                height: 48px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 18px; padding-right: 14px; spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 8px; background: Theme.mint;
                            Rectangle { x: 6px; y: 7px; width: 5px; height: 5px; background: #15352a; border-radius: 2px; }
                            Rectangle { x: 17px; y: 16px; width: 5px; height: 5px; background: #15352a; border-radius: 2px; }
                            Path { width: 28px; height: 28px; stroke: #15352a; stroke-width: 2px; MoveTo { x: 9; y: 11; } LineTo { x: 9; y: 18; } LineTo { x: 17; y: 18; } }
                        }
                    }
                    Text { text: "resend"; color: Theme.ink; font-size: 19px; font-weight: 700; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Rectangle { width: 1px; height: 22px; background: Theme.line; } }
                    Text {
                        text: UiApp.document + (UiApp.modified ? "  •" : "");
                        color: Theme.ink; font-size: 13px; vertical-alignment: center; overflow: elide;
                        accessible-role: text;
                        accessible-label: UiApp.modified ? @tr("{0}, not saved", UiApp.document) : UiApp.document;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Action { text: "↶"; accessible-text: UiApp.undo-text; small: true; width: 34px; enabled: UiApp.can-undo; clicked => { UiApp.undo(); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        Action { text: "↷"; accessible-text: UiApp.redo-text; small: true; width: 34px; enabled: UiApp.can-redo; clicked => { UiApp.redo(); } }
                    }
                }
            }
            Divider { }

            HorizontalLayout {
                vertical-stretch: 1;
                if UiApp.palette-open: PaletteView { width: 200px; fold => { UiApp.palette-open = false; } }
                if !UiApp.palette-open: FoldedPanel { text: @tr("Show the palette"); symbol: "›"; unfold => { UiApp.palette-open = true; } }
                Rectangle { width: 1px; background: Theme.line; }

                VerticalLayout {
                    horizontal-stretch: 1;
                    canvas := Canvas { vertical-stretch: 1; }
                    // Ping and playback.
                    Rectangle {
                        height: 50px;
                        background: #111c29;
                        HorizontalLayout {
                            padding: 9px; padding-left: 14px; spacing: 7px;
                            // Ping, or traceroute when checked.
                            VerticalLayout {
                                alignment: center;
                                Chip { text: @tr("Traceroute"); checked: UiRun.traceroute; tint: Theme.mint; clicked => { UiRun.traceroute = !UiRun.traceroute; } }
                            }
                            // Narrower before the bar overflows, as in a longer language.
                            LineEdit { min-width: 116px; max-width: 136px; horizontal-stretch: 1; text <=> UiRun.target; placeholder-text: @tr("Destination IPv4"); accessible-label: @tr("Destination IPv4"); accepted => { UiRun.ping(); } }
                            Text { text: UiRun.traceroute ? "≤" : "×"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                            if !UiRun.traceroute: LineEdit { min-width: 34px; max-width: 50px; horizontal-stretch: 1; text <=> UiRun.count; placeholder-text: "1"; accessible-label: @tr("Echo Requests per ping"); accepted => { UiRun.ping(); } }
                            if UiRun.traceroute: LineEdit { min-width: 34px; max-width: 50px; horizontal-stretch: 1; text <=> UiRun.hops; placeholder-text: "30"; accessible-label: @tr("Hops to try"); accepted => { UiRun.ping(); } }
                            Action {
                                text: UiRun.traceroute ? @tr("Trace") : @tr("Send");
                                accessible-text: UiRun.traceroute ? @tr("Start the traceroute") : @tr("Send the ping");
                                primary: true; enabled: UiRun.can-ping;
                                clicked => { UiRun.ping(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Action { text: UiRun.speed-label; accessible-text: @tr("Playback speed"); width: 46px; clicked => { UiRun.cycle-speed(); } }
                            Action { text: @tr("Step"); enabled: UiRun.pending && !UiRun.running; clicked => { UiRun.step(); } }
                            Action {
                                text: UiRun.running ? "Ⅱ " + @tr("Pause") : "▷ " + @tr("Run");
                                accessible-text: UiRun.running ? @tr("Pause") : @tr("Run");
                                enabled: UiRun.pending;
                                clicked => { UiRun.run-toggle(); }
                            }
                            Action { text: @tr("Reset"); accessible-text: @tr("Reset the simulation"); quiet: true; clicked => { UiRun.reset(); } }
                        }
                    }
                }

                Rectangle { width: 1px; background: Theme.line; }
                if UiApp.inspector-open: Inspector { width: 290px; fold => { UiApp.inspector-open = false; } }
                if !UiApp.inspector-open: FoldedPanel { text: @tr("Show the inspector"); symbol: "‹"; unfold => { UiApp.inspector-open = true; } }
            }

            Divider { }
            if UiApp.timeline-open: TimelinePanel { height: 250px; fold => { UiApp.timeline-open = false; } }
            if !UiApp.timeline-open: Rectangle {
                height: 30px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 10px;
                    Text { text: @tr("Timeline"); color: Theme.ink; font-weight: 600; font-size: 12px; vertical-alignment: center; }
                    Text { text: UiTimeline.title; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Action { text: "⌃"; accessible-text: @tr("Show the timeline"); quiet: true; small: true; width: 28px; clicked => { UiApp.timeline-open = true; } }
                    }
                }
            }
            Divider { }
            Rectangle {
                height: 28px;
                background: #0e1722;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                    Text {
                        text: UiRun.running ? @tr("● RUNNING") : UiRun.pending ? @tr("● PAUSED") : @tr("● READY");
                        color: Theme.mint; font-size: 9px; font-weight: 600; vertical-alignment: center;
                    }
                    Text { text: UiApp.status; color: Theme.muted; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: "resend  /  " + UiApp.version; color: Theme.muted; font-size: 9px; vertical-alignment: center; }
                }
            }
        }
    }

    if UiApp.dialog == "open" || UiApp.dialog == "save": FileDialog { saving: UiApp.dialog == "save"; }
    if UiApp.dialog == "confirm": ConfirmDialog { }
    if UiApp.dialog == "about": AboutDialog { }
}
