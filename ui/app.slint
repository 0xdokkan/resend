import { AboutSlint, LineEdit, ListView, ScrollView, Palette } from "std-widgets.slint";

// Device card size in canvas units; C++ reads it to place cables and bounds.
export global Geometry {
    out property <float> card-width: 160;
    out property <float> card-height: 94;
}

export struct NodeView {
    id: int, title: string, kind: string, address: string, mac: string,
    x: float, y: float, selected: bool, enabled: bool,
}
export struct LinkView {
    id: int, ax: float, ay: float, bx: float, by: float,
    enabled: bool, active: bool, label: string,
}
export struct TraceView {
    index: int, time: string, protocol: string, summary: string, detail: string,
    from_id: int, to_id: int, link_id: int,
}

global Theme {
    out property <color> base: #0c111b;
    out property <color> panel: #111925;
    out property <color> raised: #182333;
    out property <color> line: #253244;
    out property <color> ink: #e6edf6;
    out property <color> muted: #91a2b8;
    out property <color> mint: #7ce3c0;
    out property <color> blue: #82b8fb;
    out property <color> amber: #f1c47b;
}

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    preferred-height: 34px;
    min-height: 30px;
    min-width: label.preferred-width + 24px;
    border-radius: 7px;
    background: !root.enabled ? #18212e : root.primary ? (touch.has-hover ? #a0f1d7 : Theme.mint)
        : touch.has-hover ? #253347 : root.quiet ? transparent : Theme.raised;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.mint : root.primary ? transparent : root.quiet ? transparent : Theme.line;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    label := Text {
        text: root.text;
        color: root.primary ? #10231e : root.danger ? #f5a5a5 : Theme.ink;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

component DeviceIcon inherits Rectangle {
    in property <bool> switch-kind: false;
    in property <color> tint: Theme.mint;
    property <float> scale: root.width / 29px;
    background: transparent;
    if !root.switch-kind: Rectangle {
        x: 2px * root.scale; y: 2px * root.scale;
        width: parent.width - 4px * root.scale; height: parent.height - 9px * root.scale;
        border-width: 1.5px * root.scale; border-color: root.tint; border-radius: 3px * root.scale;
        Rectangle { width: 1.5px * root.scale; height: 5px * root.scale; x: (parent.width - self.width) / 2; y: parent.height; background: root.tint; }
        Rectangle { width: 12px * root.scale; height: 1.5px * root.scale; x: (parent.width - self.width) / 2; y: parent.height + 4px * root.scale; background: root.tint; }
    }
    if root.switch-kind: Rectangle {
        x: 1px * root.scale; y: 6px * root.scale; width: parent.width - 2px * root.scale; height: 15px * root.scale;
        border-width: 1.5px * root.scale; border-color: root.tint; border-radius: 3px * root.scale;
        for i in 4: Rectangle {
            x: (4px + i * 5px) * root.scale; y: 6px * root.scale;
            width: 3px * root.scale; height: 4px * root.scale;
            background: root.tint;
        }
    }
}

component DeviceChoice inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> switch-kind;
    callback clicked();
    height: 76px;
    border-radius: 9px;
    background: touch.has-hover ? #1e2e3d : #172331;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.mint : touch.has-hover ? #42655e : Theme.line;
    accessible-role: button;
    accessible-label: "Add " + root.title;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    DeviceIcon { x: 13px; y: 14px; width: 29px; height: 28px; switch-kind: root.switch-kind; tint: root.switch-kind ? Theme.blue : Theme.mint; }
    Text { x: 53px; y: 16px; text: root.title; color: Theme.ink; font-size: 14px; font-weight: 600; }
    Text { x: 13px; y: 52px; text: root.subtitle; color: Theme.muted; font-size: 10px; }
    Text { x: parent.width - 24px; y: 19px; text: "+"; color: Theme.muted; font-size: 19px; }
    focus := FocusScope {
        focus-on-tab-navigation: true;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "resend — Network sandbox";
    preferred-width: 1360px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 760px;
    background: Theme.base;
    default-font-family: "Inter";
    default-font-size: 13px;

    in property <[NodeView]> nodes;
    in property <[LinkView]> links;
    in property <[TraceView]> traces;
    in property <int> selected-id: -1;
    in property <string> selected-kind;
    in property <string> selected-mac;
    in property <string> selected-details;
    in property <int> link-source-id: -1;
    in-out property <string> edit-name;
    in-out property <string> edit-ip;
    in-out property <string> edit-prefix;
    in-out property <string> target-ip: "192.168.1.20";
    in property <bool> running;
    in property <bool> has-pending;
    in property <string> status-text: "Select a host to send a ping.";
    in property <int> event-count;
    in property <string> event-title;
    in property <string> event-detail;
    in property <string> event-protocol;
    in property <int> selected-event: -1;
    // True while the selection follows the newest event.
    in property <bool> follow-events: true;
    // Bounding box of all cards, in canvas units.
    in property <float> bounds-left;
    in property <float> bounds-top;
    in property <float> bounds-right;
    in property <float> bounds-bottom;

    // Kind, then the canvas position (top-left corner of the card).
    callback add-node(string, float, float);
    callback select-node(int);
    callback move-node(int, float, float);
    callback link-node(int);
    callback delete-selected();
    callback apply-node(string, string, string);
    callback ping();
    callback step();
    callback run-toggle();
    callback reset();
    callback load-demo();
    callback clear-workspace();
    callback toggle-link(int);
    callback remove-link(int);
    callback select-event(int);

    property <float> zoom: 1.0;
    property <length> pan-x: 40px;
    property <length> pan-y: 60px;
    property <length> pan-origin-x;
    property <length> pan-origin-y;
    property <length> drag-offset-x;
    property <length> drag-offset-y;
    property <float> next-zoom;
    property <float> packet-phase: 0;
    // While true, resizing the window keeps the whole network in view.
    property <bool> auto-fit: true;
    property <bool> show-about;
    property <length> trace-row-height: 35px;

    public function fit-view() {
        root.auto-fit = true;
        if root.bounds-right <= root.bounds-left || root.bounds-bottom <= root.bounds-top {
            root.zoom = 1.0;
            root.pan-x = 40px;
            root.pan-y = 60px;
        } else {
            root.zoom = max(0.35, min(1.0, min(
                (canvas.width - 96px) / ((root.bounds-right - root.bounds-left) * 1px),
                (canvas.height - 96px) / ((root.bounds-bottom - root.bounds-top) * 1px))));
            root.pan-x = (canvas.width - (root.bounds-right - root.bounds-left) * root.zoom * 1px) / 2 - root.bounds-left * root.zoom * 1px;
            root.pan-y = (canvas.height - (root.bounds-bottom - root.bounds-top) * root.zoom * 1px) / 2 - root.bounds-top * root.zoom * 1px;
        }
    }

    // Canvas position that centers a new card in the visible area.
    function view-center-x() -> float {
        return (canvas.width / 2 - root.pan-x) / (root.zoom * 1px) - Geometry.card-width / 2;
    }
    function view-center-y() -> float {
        return (canvas.height / 2 - root.pan-y) / (root.zoom * 1px) - Geometry.card-height / 2;
    }

    // Scrolls the event list just enough to show the row.
    public function reveal-event(index: int) {
        if index >= 0 {
            if index * root.trace-row-height < -event-list.content-y {
                event-list.content-y = -index * root.trace-row-height;
            } else if (index + 1) * root.trace-row-height > -event-list.content-y + event-list.visible-height {
                event-list.content-y = event-list.visible-height - (index + 1) * root.trace-row-height;
            }
        }
    }

    init => { Palette.color-scheme = ColorScheme.dark; }
    Timer {
        running: root.running;
        interval: 30ms;
        triggered => { root.packet-phase = Math.mod(root.packet-phase + 0.05, 1.0); }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 68px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 24px; padding-right: 22px;
                padding-top: 16px; padding-bottom: 16px; spacing: 14px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 10px; background: Theme.mint;
                    Rectangle { x: 8px; y: 9px; width: 6px; height: 6px; background: #15352a; border-radius: 2px; }
                    Rectangle { x: 20px; y: 19px; width: 6px; height: 6px; background: #15352a; border-radius: 2px; }
                    Path { width: 34px; height: 34px; stroke: #15352a; stroke-width: 2px; MoveTo { x: 11; y: 14; } LineTo { x: 11; y: 22; } LineTo { x: 20; y: 22; } }
                }
                Text { text: "resend"; color: Theme.ink; font-size: 23px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 1px; height: 25px; y: 5px; background: Theme.line; }
                Text { text: "Your networking lab"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 118px; border-radius: 17px; background: #17312c;
                    Text { text: "●  LOCAL SANDBOX"; color: Theme.mint; font-size: 9px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
                }
                Action { text: "Sample network"; clicked => { root.load-demo(); root.fit-view(); } }
                Action { text: "Clear"; quiet: true; clicked => { root.clear-workspace(); } }
                Action { text: "About"; quiet: true; clicked => { root.show-about = true; } }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 190px; background: Theme.panel;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Caption { text: "DEVICES"; height: 22px; }
                    DeviceChoice { title: "Host"; subtitle: "IPv4 · 1 Ethernet port"; switch-kind: false; clicked => { root.add-node("host", root.view-center-x(), root.view-center-y()); } }
                    DeviceChoice { title: "Switch"; subtitle: "Layer 2 · 8 ports"; switch-kind: true; clicked => { root.add-node("switch", root.view-center-x(), root.view-center-y()); } }
                    Text { text: "Click to add.\nDrag to arrange."; color: Theme.muted; font-size: 11px; wrap: word-wrap; height: 48px; }
                    Rectangle { height: 1px; background: Theme.line; }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle {
                        height: 91px; border-radius: 8px; background: #172331;
                        VerticalLayout {
                            padding: 11px; spacing: 5px;
                            Text { text: "FIRST STEPS"; color: Theme.blue; font-size: 9px; font-weight: 600; }
                            Text { text: "Ethernet, ARP, IPv4, ICMP.\nTCP and routing will come\nin later modules."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                horizontal-stretch: 1; spacing: 0px;
                Rectangle {
                    height: 54px; background: #101824;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 16px; padding-top: 10px; padding-bottom: 10px; spacing: 8px;
                        Text { text: "Topology"; color: Theme.ink; font-weight: 600; vertical-alignment: center; }
                        Text { text: root.nodes.length + " devices · " + root.links.length + " links"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Action { text: "Fit"; clicked => { root.fit-view(); } }
                        Action { text: "−"; width: 30px; clicked => { root.auto-fit = false; root.zoom = max(0.35, root.zoom / 1.15); } }
                        Action { text: Math.round(root.zoom * 100) + "%"; width: 56px; clicked => { root.auto-fit = false; root.zoom = 1; root.pan-x = 40px; root.pan-y = 60px; } }
                        Action { text: "+"; width: 30px; clicked => { root.auto-fit = false; root.zoom = min(2.2, root.zoom * 1.15); } }
                    }
                }
                canvas := Rectangle {
                    background: #0d1520; clip: true;
                    accessible-role: groupbox;
                    accessible-label: "Network topology";
                    changed width => { if root.auto-fit { root.fit-view(); } }
                    changed height => { if root.auto-fit { root.fit-view(); } }
                    for gx in 54: Rectangle {
                        x: Math.mod(gx * 28px * root.zoom + root.pan-x, canvas.width + 28px * root.zoom) - 28px * root.zoom;
                        width: 1px; height: parent.height; background: #192535; opacity: 0.55;
                    }
                    for gy in 40: Rectangle {
                        y: Math.mod(gy * 28px * root.zoom + root.pan-y, canvas.height + 28px * root.zoom) - 28px * root.zoom;
                        width: parent.width; height: 1px; background: #192535; opacity: 0.55;
                    }
                    background-touch := TouchArea {
                        mouse-cursor: grab;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                root.pan-origin-x = root.pan-x;
                                root.pan-origin-y = root.pan-y;
                                root.select-node(-1);
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.auto-fit = false;
                                root.pan-x = root.pan-origin-x + self.mouse-x - self.pressed-x;
                                root.pan-y = root.pan-origin-y + self.mouse-y - self.pressed-y;
                            }
                        }
                        scroll-event(e) => {
                            root.auto-fit = false;
                            root.next-zoom = min(2.2, max(0.35, root.zoom * (e.delta-y > 0px ? 1.1 : 0.90909)));
                            root.pan-x = self.mouse-x - (self.mouse-x - root.pan-x) * root.next-zoom / root.zoom;
                            root.pan-y = self.mouse-y - (self.mouse-y - root.pan-y) * root.next-zoom / root.zoom;
                            root.zoom = root.next-zoom;
                            return accept;
                        }
                    }

                    for link in root.links: Path {
                        width: canvas.width; height: canvas.height;
                        viewbox-width: canvas.width / 1px; viewbox-height: canvas.height / 1px;
                        stroke: !link.enabled ? #586473 : link.active ? Theme.mint : #4f7493;
                        stroke-width: link.active ? 3px : 2px;
                        MoveTo { x: link.ax * root.zoom + root.pan-x / 1px; y: link.ay * root.zoom + root.pan-y / 1px; }
                        LineTo { x: link.bx * root.zoom + root.pan-x / 1px; y: link.by * root.zoom + root.pan-y / 1px; }
                    }
                    for link in root.links: Rectangle {
                        x: (link.ax + link.bx) / 2 * root.zoom * 1px + root.pan-x - 12px;
                        y: (link.ay + link.by) / 2 * root.zoom * 1px + root.pan-y - 12px;
                        width: 24px; height: 24px; border-radius: 12px;
                        background: link-touch.has-hover ? #365249 : #152434;
                        border-color: link.enabled ? #5a7c91 : #be8e70; border-width: 1px;
                        Text { text: link.enabled ? "•" : "×"; color: link.enabled ? Theme.mint : Theme.amber; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                        accessible-role: button;
                        accessible-label: (link.enabled ? "Disable " : "Enable ") + link.label;
                        accessible-action-default => { root.toggle-link(link.id); }
                        link-touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-link(link.id); } }
                    }
                    for link in root.links: Rectangle {
                        visible: link.active && link.enabled;
                        x: (link.ax + (link.bx - link.ax) * (root.running ? root.packet-phase : 0.38)) * root.zoom * 1px + root.pan-x - 4px;
                        y: (link.ay + (link.by - link.ay) * (root.running ? root.packet-phase : 0.38)) * root.zoom * 1px + root.pan-y - 4px;
                        width: 8px; height: 8px; border-radius: 3px; background: Theme.mint;
                    }

                    for node in root.nodes: Rectangle {
                        x: node.x * root.zoom * 1px + root.pan-x;
                        y: node.y * root.zoom * 1px + root.pan-y;
                        width: Geometry.card-width * 1px * root.zoom; height: Geometry.card-height * 1px * root.zoom;
                        border-radius: 10px * root.zoom;
                        background: node.selected ? #1d3440 : #172534;
                        border-width: node.selected ? 2px : 1px;
                        border-color: node.selected ? Theme.mint : #365068;
                        drop-shadow-blur: 12px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000055;
                        opacity: node.enabled ? 1 : 0.55;
                        accessible-role: button;
                        accessible-label: node.title + ", " + node.address;
                        accessible-description: "Arrows to move, Enter to connect, Delete to remove.";
                        accessible-action-default => { root.select-node(node.id); }
                        forward-focus: node-focus;
                        DeviceIcon { x: 12px * root.zoom; y: 13px * root.zoom; width: 27px * root.zoom; height: 25px * root.zoom; switch-kind: node.kind == "switch"; tint: node.kind == "switch" ? Theme.blue : Theme.mint; }
                        Text { x: 47px * root.zoom; y: 14px * root.zoom; width: 101px * root.zoom; text: node.title; overflow: elide; font-size: 13px * root.zoom; font-weight: 600; color: Theme.ink; }
                        Text { x: 47px * root.zoom; y: 33px * root.zoom; text: node.kind == "switch" ? "SWITCH L2" : "HOST"; font-size: 8px * root.zoom; font-weight: 600; color: Theme.muted; letter-spacing: 1px * root.zoom; }
                        Rectangle { x: 12px * root.zoom; y: 53px * root.zoom; width: 136px * root.zoom; height: 1px; background: #2b4153; }
                        Text { x: 12px * root.zoom; y: 67px * root.zoom; width: 104px * root.zoom; text: node.address; overflow: elide; color: Theme.muted; font-size: 10px * root.zoom; }
                        node-focus := FocusScope {
                            focus-on-tab-navigation: true;
                            focus-gained(reason) => { root.select-node(node.id); }
                            key-pressed(e) => {
                                if e.text == Key.LeftArrow { root.move-node(node.id, node.x - 10, node.y); return accept; }
                                if e.text == Key.RightArrow { root.move-node(node.id, node.x + 10, node.y); return accept; }
                                if e.text == Key.UpArrow { root.move-node(node.id, node.x, node.y - 10); return accept; }
                                if e.text == Key.DownArrow { root.move-node(node.id, node.x, node.y + 10); return accept; }
                                if e.text == Key.Delete { root.delete-selected(); return accept; }
                                if e.text == "\n" { root.link-node(node.id); return accept; }
                                return reject;
                            }
                        }
                        node-drag := TouchArea {
                            mouse-cursor: move;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                    root.select-node(node.id);
                                    node-focus.focus();
                                    root.drag-offset-x = self.mouse-x;
                                    root.drag-offset-y = self.mouse-y;
                                }
                            }
                            moved => {
                                if self.pressed {
                                    root.move-node(node.id,
                                        (self.absolute-position.x + self.mouse-x - canvas.absolute-position.x - root.pan-x - root.drag-offset-x) / (root.zoom * 1px),
                                        (self.absolute-position.y + self.mouse-y - canvas.absolute-position.y - root.pan-y - root.drag-offset-y) / (root.zoom * 1px));
                                }
                            }
                        }
                        Rectangle {
                            x: 128px * root.zoom; y: 62px * root.zoom;
                            width: 23px * root.zoom; height: 23px * root.zoom;
                            border-radius: 6px * root.zoom;
                            background: root.link-source-id == node.id ? Theme.mint : port.has-hover ? #305747 : #253f40;
                            border-color: Theme.mint; border-width: 1px;
                            Text { text: "+"; color: root.link-source-id == node.id ? #16382a : Theme.mint; font-size: 17px * root.zoom; horizontal-alignment: center; vertical-alignment: center; }
                            accessible-role: button;
                            accessible-label: "Connect " + node.title;
                            accessible-action-default => { root.link-node(node.id); }
                            port := TouchArea { mouse-cursor: pointer; clicked => { root.link-node(node.id); } }
                        }
                    }
                    if root.nodes.length == 0: VerticalLayout {
                        padding: 60px; alignment: center; spacing: 12px;
                        Text { text: "A network starts\nwith a connection."; color: Theme.ink; font-size: 28px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: "Add a host or a switch from the panel on the left."; color: Theme.muted; font-size: 12px; wrap: word-wrap; horizontal-alignment: center; }
                    }
                    Rectangle {
                        x: 16px; y: 14px; width: note.preferred-width + 24px; height: 28px;
                        background: root.link-source-id >= 0 ? #234438 : #121e2b;
                        border-radius: 6px;
                        note := Text {
                            text: root.link-source-id >= 0 ? "Connecting: press + on the second device" : "Drag the background · Wheel to zoom · + to connect";
                            color: root.link-source-id >= 0 ? Theme.mint : Theme.muted;
                            font-size: 10px; horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    height: 59px; background: #111c29;
                    HorizontalLayout {
                        padding: 12px; spacing: 8px;
                        Text { text: "PING"; color: Theme.mint; font-weight: 600; font-size: 10px; vertical-alignment: center; }
                        LineEdit { width: 144px; text <=> root.target-ip; placeholder-text: "Destination IPv4"; accessible-label: "Destination IPv4"; }
                        Action { text: "Send"; primary: true; enabled: root.selected-kind == "host" && !root.has-pending; clicked => { root.ping(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Action { text: "Step →"; enabled: root.has-pending && !root.running; clicked => { root.step(); } }
                        Action { text: root.running ? "Ⅱ Pause" : "▷ Run"; enabled: root.has-pending; clicked => { root.run-toggle(); } }
                        Action { text: "Reset"; quiet: true; clicked => { root.reset(); } }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }

            Rectangle {
                width: 272px; background: Theme.panel;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    Rectangle {
                        height: 54px;
                        HorizontalLayout {
                            padding: 18px;
                            Text { text: "Inspector"; color: Theme.ink; font-size: 13px; font-weight: 600; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.selected-id < 0 ? "—" : "#" + root.selected-id; color: Theme.muted; font-size: 11px; }
                        }
                    }
                    ScrollView {
                        content-width: self.visible-width;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-left: 18px; padding-right: 18px; padding-bottom: 18px; spacing: 10px; alignment: start;
                            if root.selected-id < 0: Text { text: "Select a device\nto explore its configuration\nand the network state."; color: Theme.muted; font-size: 12px; wrap: word-wrap; height: 75px; }
                            if root.selected-id >= 0: VerticalLayout {
                                spacing: 9px;
                                Caption { text: root.selected-kind == "switch" ? "ETHERNET SWITCH" : "IPv4 HOST"; height: 22px; }
                                Text { text: "Name"; color: Theme.muted; font-size: 11px; }
                                LineEdit { text <=> root.edit-name; placeholder-text: "Device name"; accessible-label: "Name"; }
                                if root.selected-kind == "host": VerticalLayout {
                                    spacing: 9px;
                                    Text { text: "IPv4 address"; color: Theme.muted; font-size: 11px; }
                                    LineEdit { text <=> root.edit-ip; placeholder-text: "192.168.1.10"; accessible-label: "IPv4 address"; }
                                    Text { text: "Prefix length (CIDR)"; color: Theme.muted; font-size: 11px; }
                                    LineEdit { text <=> root.edit-prefix; placeholder-text: "24"; accessible-label: "Prefix length"; }
                                }
                                Action { text: "Apply configuration"; clicked => { root.apply-node(root.edit-name, root.edit-ip, root.edit-prefix); } }
                                Text { text: "MAC  " + root.selected-mac; color: Theme.muted; font-size: 10px; overflow: elide; height: 23px; }
                                Rectangle { height: 1px; background: Theme.line; }
                                Caption { text: "DEVICE STATE"; height: 20px; }
                                Text { text: root.selected-details; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                Action { text: "Delete device"; danger: true; quiet: true; clicked => { root.delete-selected(); } }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            Caption { text: "LINKS  /  " + root.links.length; height: 24px; }
                            if root.links.length == 0: Text { text: "Press + on two devices\nto connect their free ports."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                            for link in root.links: VerticalLayout {
                                spacing: 5px;
                                Text { text: link.label; color: Theme.ink; font-size: 10px; overflow: elide; }
                                HorizontalLayout {
                                    spacing: 5px;
                                    Action { text: link.enabled ? "● Up" : "○ Down"; clicked => { root.toggle-link(link.id); } }
                                    Action { text: "×"; width: 33px; danger: true; clicked => { root.remove-link(link.id); } }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            height: 220px; background: Theme.panel;
            HorizontalLayout {
                spacing: 0px;
                VerticalLayout {
                    horizontal-stretch: 58; min-width: 300px; preferred-width: 440px; spacing: 0px;
                    Rectangle {
                        height: 43px; background: #15202d;
                        HorizontalLayout {
                            padding-left: 22px; padding-right: 20px; spacing: 12px;
                            Text { text: "Event sequence"; color: Theme.ink; font-weight: 600; font-size: 12px; vertical-alignment: center; }
                            Text { text: root.event-count + " events"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: "SIMULATED TIME"; color: Theme.muted; font-size: 9px; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        accessible-role: list;
                        accessible-label: "Event list";
                        // ListView only instantiates the visible rows.
                        event-list := ListView {
                            horizontal-scrollbar-policy: always-off;
                            // The virtualized content height settles only after layout,
                            // so a new last row can be revealed only once it has grown.
                            changed content-height => { if root.follow-events { root.reveal-event(root.selected-event); } }
                            for trace in root.traces: Rectangle {
                                height: root.trace-row-height;
                                Rectangle {
                                    x: 7px; y: 1px; width: parent.width - 14px; height: parent.height - 2px;
                                    border-radius: 5px;
                                    background: root.selected-event == trace.index ? #243b43 : trace-touch.has-hover ? #1c2a3b : transparent;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                                        Text { text: trace.time; color: Theme.muted; font-size: 10px; width: 73px; vertical-alignment: center; }
                                        Text { text: trace.protocol; color: trace.protocol == "ARP" ? Theme.amber : trace.protocol == "ICMP" ? Theme.mint : Theme.blue; font-size: 10px; font-weight: 600; width: 60px; vertical-alignment: center; }
                                        Text { text: trace.summary; color: Theme.ink; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                    }
                                }
                                accessible-role: button;
                                accessible-label: trace.protocol + ": " + trace.summary;
                                accessible-action-default => { root.select-event(trace.index); }
                                forward-focus: trace-focus;
                                trace-focus := FocusScope {
                                    focus-on-tab-navigation: true;
                                    focus-gained(reason) => { root.select-event(trace.index); }
                                    key-pressed(e) => { if e.text == " " || e.text == "\n" { root.select-event(trace.index); return accept; } return reject; }
                                }
                                trace-touch := TouchArea { mouse-cursor: pointer; clicked => { trace-focus.focus(); root.select-event(trace.index); } }
                            }
                        }
                        if root.traces.length == 0: Text { text: "The next experiment starts with a ping. Events will appear here."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                    }
                }
                Rectangle { width: 1px; background: Theme.line; }
                Rectangle {
                    // Explicit sizes on both sides: the split must not move as events arrive.
                    horizontal-stretch: 42; min-width: 320px; preferred-width: 320px;
                    VerticalLayout {
                        padding: 20px; spacing: 10px;
                        Caption { text: root.event-protocol == "" ? "SEE WHY" : "INSIDE THE PACKET  /  " + root.event-protocol; }
                        Text { text: root.event-title == "" ? "Every step has an explanation." : root.event-title; color: Theme.ink; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    text: root.event-detail == "" ? "Select an event to follow the addresses, the switch decisions and the exchanges between hosts. Change a configuration and see what happens." : root.event-detail;
                                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            height: 32px; background: #0e1722;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px;
                Text { text: root.running ? "● RUNNING" : root.has-pending ? "● PAUSED" : "● READY"; color: Theme.mint; font-size: 9px; font-weight: 600; vertical-alignment: center; }
                Text { text: root.status-text; color: Theme.muted; font-size: 10px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "resend  /  prototype 0.1"; color: Theme.muted; font-size: 9px; vertical-alignment: center; }
            }
        }
    }

    // Slint's Royalty-free license asks for the AboutSlint widget in an
    // "About" screen reachable from the main window.
    if root.show-about: Rectangle {
        background: #000000b0;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            width: 380px;
            height: about-layout.preferred-height;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.panel;
            accessible-role: groupbox;
            accessible-label: "About resend";
            // Clicks on the card must not reach the backdrop, which closes it.
            TouchArea { }
            about-layout := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: "resend"; color: Theme.ink; font-size: 22px; font-weight: 700; }
                Text { text: "Prototype 0.1 · a local network sandbox with Ethernet, ARP, IPv4 and ICMP."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                Text { text: "© 2026 Zayd Soulmani · MIT License"; color: Theme.ink; font-size: 12px; }
                Text { text: "The interface uses Slint under the Royalty-free License 2.0."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                AboutSlint { }
                HorizontalLayout {
                    alignment: end;
                    Action { text: "Close"; clicked => { root.show-about = false; } }
                }
            }
        }
    }
}
