import { Palette } from "std-widgets.slint";
import "../assets/fonts/PixelifySans-Regular.ttf";
import "../assets/fonts/PixelifySans-SemiBold.ttf";
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";
import "../assets/fonts/JetBrainsMono-Bold.ttf";
import { Theme, Tones, Type, Motion, Geometry, UiSound } from "theme.slint";
import { UiSprites } from "sprites.slint";
import { Action, Caption, Chip, DeviceIcon, Icon, PixelFrame, TextBox, TipLayer, UiTip } from "widgets.slint";
import { UiCanvas, Canvas, ContextMenu, NodeView, LinkView, PacketView, MarkerView, ShapeView } from "canvas.slint";
import { UiInspector, Inspector, PortView, RouteView } from "inspector.slint";
import { UiTimeline, TimelineBar, TimelinePanel, EventView } from "timeline.slint";
import { UiFrame, FieldRow, HexByte, HexRow } from "frame.slint";
import { UiApp, UiRun, UiLab, ExampleView, FileView, ThemeView, CommandView, GoalView, LabEntryView } from "state.slint";
import { FileDialog, ConfirmDialog, AboutDialog, CommandPalette, KeyMap, Welcome, LabLibrary } from "dialogs.slint";
