// The document, the dialogs, the menus and the run controls
// (src/app_controller.cpp, src/app_documents.cpp).

export struct ExampleView { title: string, file: string }
export struct FileView { name: string, folder: bool }
export struct ThemeView { id: string, title: string }
// An action of the command palette: what the menus and the keys do.
// `group` names the menu it comes from, `keys` its shortcut.
export struct CommandView { id: string, title: string, group: string, keys: string, enabled: bool }

export global UiApp {
    // The file's name, or "Untitled".
    in property <string> document;
    in property <bool> modified;
    // The network's title and its lesson notes.
    in property <string> title;
    in property <string> notes;
    in property <string> status;
    in property <string> version: "dev";

    in property <bool> can-undo;
    in property <bool> can-redo;
    // What undo and redo would do, e.g. "Undo Move PC-A".
    in property <string> undo-text;
    in property <string> redo-text;

    in property <[ExampleView]> examples;
    // The themes of assets/palettes.json and the one chosen.
    in property <[ThemeView]> themes;
    in property <string> theme;

    // The HUD hidden with H: only the canvas shows.
    in-out property <bool> hud-hidden;
    // The command palette (Ctrl+K): every action, filtered by what is typed.
    in property <[CommandView]> commands;
    in-out property <string> command-filter;
    // A short answer to an action, such as undo or a save; shown for a few
    // seconds each time `toast-serial` changes.
    in property <string> toast;
    in property <int> toast-serial;

    in-out property <bool> palette-open: true;
    in-out property <bool> inspector-open: true;
    // The timeline is one row until opened into its events, Why and Frame.
    in-out property <bool> timeline-open: false;

    // "", "open", "save", "confirm", "about", "commands", "keys", "welcome", "labs"
    in property <string> dialog;
    in property <string> dialog-title;
    in property <string> dialog-message;
    // The buttons of a confirmation, as answers: the first is the default.
    in property <[string]> dialog-answers;
    in property <[string]> dialog-answer-texts;
    // The file dialog.
    in property <string> folder;
    in property <[FileView]> entries;
    in-out property <string> file-name;
    in property <string> browser-error;

    callback new-document();
    callback open-document();
    callback open-example(int);
    callback save();
    callback save-as();
    callback quit();
    callback undo();
    callback redo();
    callback add-device(string);
    callback delete-selection();
    // "full", "reduced", "off", or "next" for the one after the current.
    callback set-effects(string);
    callback about();
    callback set-theme(string);
    callback run-command(string);
    callback filter-commands(string);
    callback show-commands();
    callback show-keys();

    callback browse-enter(string);
    callback browse-up();
    callback browse-home();
    // A file clicked in the list: opened, or its name taken for saving.
    callback browse-pick(string);
    callback browse-confirm();
    callback answer(string);
    callback close-dialog();
    // Escape in a dialog: its Cancel or Close.
    callback dismiss-dialog();
}

export global UiRun {
    in-out property <string> target: "192.168.1.20";
    // Echo Requests per ping.
    in-out property <string> count: "1";
    // A traceroute instead of a ping, and the hops it tries.
    in-out property <bool> traceroute;
    in-out property <string> hops: "30";
    in property <bool> can-ping;
    // The host a ping starts from, the one selected on the canvas; "" when
    // no host is.
    in property <string> source;
    // True while the animation plays, including a step in progress.
    in property <bool> running;
    in property <bool> pending;
    in property <string> speed-label: "1×";
    in property <float> speed: 1;

    callback ping();
    callback step();
    callback run-toggle();
    callback reset();
    callback cycle-speed();
    callback set-speed(float);
    callback latest();
}

// A goal of the lab, as the last check left it. `state` is "open" before
// any check or after a change since, "met" or "unmet"; `detail` says why.
// A goal that `asks` a question has an answer field. A `fresh` goal was met
// by the last check and not by the one before: it glows for a moment.
export struct GoalView { text: string, state: string, detail: string, asks: bool, answer: string, fresh: bool }
// A lab of the library: `first` starts a topic.
export struct LabEntryView { title: string, topic: string, kind: string, solved: bool, first: bool }

// The lab being done (src/app_lab.cpp): its brief, steps and goals, and the
// library of the labs built in.
export global UiLab {
    in property <bool> active;
    in property <string> title;
    // Guided, Challenge or Troubleshooting, in words.
    in property <string> kind;
    in property <string> brief;
    in property <[string]> steps;
    in property <[GoalView]> goals;
    // "2 of 5 goals met", or what to do before the first check.
    in property <string> progress;
    in property <bool> solved;
    // The hints shown so far, one more each time, and how many there are.
    in property <[string]> hints;
    in property <int> hint-count;
    // The solution in view instead of the learner's network.
    in property <bool> showing-solution;
    in property <[LabEntryView]> library;
    in-out property <bool> open: true;
    // The moment the lab is solved, from 0 to 1 while it plays; -1 when
    // there is none. The serial counts the moments.
    in property <float> celebration: -1;
    in property <int> celebration-serial;

    callback check();
    callback restart();
    callback next-hint();
    callback toggle-solution();
    callback answer(int, string);
    callback open-lab(int);
    callback show-library();
    callback leave();
    // Plays again what decided the goals.
    callback replay();
}
