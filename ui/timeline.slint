import { ListView } from "std-widgets.slint";
import { Theme, Tones, Type } from "theme.slint";
import { UiSprites } from "sprites.slint";
import { Action, Caption, Chip, PixelFrame, Scroll, ScrollBar, Scrubber, Tabs } from "widgets.slint";
import { UiApp, UiRun } from "state.slint";
import { FrameView } from "frame.slint";

// An event the filters let through; `index` is its place among all events.
export struct EventView {
    index: int, time: string, protocol: string, summary: string, problem: bool,
}

// The events, the filters, the time scrubber and the explanation of the
// selected event (src/app_controller.cpp).
export global UiTimeline {
    in property <[EventView]> events;
    in property <int> total;
    in property <int> selected: -1;
    // The selection follows the newest event.
    in property <bool> follow: true;
    // A row of `events` to scroll into view, when `reveal-serial` changes.
    in property <int> reveal-row: -1;
    in property <int> reveal-serial;
    in property <string> protocol;
    in property <string> title;
    in property <string> detail;
    // Why tab or Frame tab.
    in-out property <int> tab;

    in property <bool> arp: true;
    in property <bool> icmp: true;
    in property <bool> ipv4: true;
    in property <bool> edits: true;
    in property <bool> simulator: true;
    in property <bool> problems;
    in property <bool> device-only;
    in property <string> device-name;
    in property <bool> filtered;

    // The instant shown and the latest one, in milliseconds.
    in-out property <float> now-ms;
    in property <float> end-ms;
    // Later changes lie ahead: the network cannot be changed.
    in property <bool> locked;

    callback select(int);
    // "arp", "icmp", "ipv4", "edits", "simulator", "problems", "device"
    callback toggle-filter(string);
    callback clear-filters();
    callback scrub(float);
    callback latest();
}

// The timeline folded to one row: the playback, the instant shown, and what
// happened last.
export component TimelineBar inherits PixelFrame {
    // Where there is little room, the buttons keep their icons only.
    property <bool> compact: root.width < 1000px;
    fill: Theme.panel;
    accessible-role: groupbox;
    accessible-label: @tr("Timeline");
    HorizontalLayout {
        padding-left: 14px; padding-right: 8px; spacing: 8px;
        Text { text: @tr("Timeline"); color: Theme.ink; font-family: Type.pixel; font-size: Type.pixel-title; font-weight: 600; vertical-alignment: center; }
        // The playback: it lights up when something waits to be played.
        VerticalLayout {
            alignment: center;
            Action {
                icon: UiRun.running ? UiSprites.pause : UiSprites.play;
                text: root.compact ? "" : UiRun.running ? @tr("Pause") : @tr("Run");
                accessible-text: UiRun.running ? @tr("Pause") : @tr("Run");
                tip: UiRun.pending ? "" : @tr("Run: nothing to play yet, send a ping first");
                keys: "Space";
                small: true; primary: UiRun.pending && !UiRun.running; enabled: UiRun.pending;
                min-width: 36px;
                clicked => { UiRun.run-toggle(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Action {
                icon: UiSprites.step; text: root.compact ? "" : @tr("Step"); accessible-text: @tr("Step");
                tip: @tr("Step: play one event");
                keys: ".";
                small: true; enabled: UiRun.pending && !UiRun.running;
                min-width: 36px;
                clicked => { UiRun.step(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Action { text: UiRun.speed-label; accessible-text: @tr("Playback speed"); keys: "]"; small: true; width: 48px; clicked => { UiRun.cycle-speed(); } }
        }
        VerticalLayout {
            alignment: center;
            Action { icon: UiSprites.reset; accessible-text: @tr("Reset the simulation"); keys: "R"; quiet: true; small: true; width: 32px; clicked => { UiRun.reset(); } }
        }
        VerticalLayout { alignment: center; Rectangle { width: 1px; height: 22px; background: Theme.line; } }
        Scrubber {
            horizontal-stretch: 2;
            min-width: 120px;
            y: (parent.height - self.height) / 2;
            minimum: 0;
            maximum: max(UiTimeline.end-ms, 0.001);
            value <=> UiTimeline.now-ms;
            enabled: UiTimeline.end-ms > 0;
            label: @tr("Instant shown");
            changed(value) => { UiTimeline.scrub(value); }
        }
        VerticalLayout {
            alignment: center;
            Action {
                text: @tr("Latest");
                accessible-text: @tr("Go to the latest instant");
                keys: "End";
                small: true;
                enabled: UiTimeline.now-ms < UiTimeline.end-ms;
                clicked => { UiTimeline.latest(); }
            }
        }
        // What is shown: the past, or the newest event.
        Text {
            horizontal-stretch: 3;
            min-width: 40px;
            text: UiTimeline.locked ? @tr("You are looking at the past: later changes lie ahead. Go to the latest instant to change the network.")
                : UiTimeline.title;
            color: UiTimeline.locked ? Theme.ask.text : Theme.muted;
            font-size: Type.small; overflow: elide; vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Action {
                icon: UiApp.timeline-open ? UiSprites.chevron-down : UiSprites.chevron-up;
                text: root.compact ? "" : UiApp.timeline-open ? @tr("Hide events") : @tr("Events");
                accessible-text: UiApp.timeline-open ? @tr("Hide the timeline") : @tr("Show the timeline");
                keys: "L";
                quiet: true; small: true; min-width: 32px;
                clicked => { UiApp.timeline-open = !UiApp.timeline-open; }
            }
        }
    }
}

// Why the selected event happened, in words. A component of its own, not a
// box written under the `if` of its tab: Slint 1.18 measures a wrapped text
// written straight under an `if` as one line, and a long explanation could
// not be scrolled to its end.
component WhyView inherits Rectangle {
    clip: true;
    PixelFrame { width: 100%; height: 100%; unit: UiSprites.unit / 2; shadow: false; fill: Theme.sunken; border: Theme.edge; }
    VerticalLayout {
        padding: 12px; spacing: 6px;
        Caption {
            text: UiTimeline.protocol == "" ? @tr("SEE WHY") : UiTimeline.protocol == "EDIT" ? @tr("A CHANGE TO THE NETWORK")
                : UiTimeline.protocol == "SIMULATOR" ? @tr("THE SIMULATOR STEPPED IN") : @tr("INSIDE THE PACKET  /  {0}", UiTimeline.protocol);
            color: UiTimeline.protocol == "" ? Theme.muted : Theme.protocol(UiTimeline.protocol).text;
        }
        Text { text: UiTimeline.title; color: Theme.ink; font-size: Type.label; font-weight: 600; wrap: word-wrap; }
        Scroll {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding-right: 14px;
                Text { text: UiTimeline.detail; color: Theme.ink; font-size: Type.small; wrap: word-wrap; }
            }
        }
    }
}

// The timeline opened: filters, the events, and why the selected one happened.
export component TimelinePanel inherits PixelFrame {
    property <length> row-height: 30px;
    // The events take a share of the panel that does not move as they
    // arrive; Why and Frame take the rest, however narrow the panel is.
    property <length> list-width: max(200px, min(440px, (root.width - 24px) * 0.44));
    property <int> reveal-serial: UiTimeline.reveal-serial;
    changed reveal-serial => { root.reveal(UiTimeline.reveal-row); }

    // Scrolls the event list just enough to show a row of the filtered list.
    public function reveal(row: int) {
        if row >= 0 {
            if row * root.row-height < -event-list.content-y {
                event-list.content-y = -row * root.row-height;
            } else if (row + 1) * root.row-height > -event-list.content-y + event-list.visible-height {
                event-list.content-y = event-list.visible-height - (row + 1) * root.row-height;
            }
        }
    }

    fill: Theme.panel;
    accessible-role: groupbox;
    accessible-label: @tr("Events");
    VerticalLayout {
    padding: 8px;
    spacing: 4px;
                // Filters.
                Rectangle {
                    height: 34px;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 5px;
                        alignment: start;
                        VerticalLayout { alignment: center; Chip { text: "ARP"; tint: Theme.ask; checked: UiTimeline.arp; clicked => { UiTimeline.toggle-filter("arp"); } } }
                        VerticalLayout { alignment: center; Chip { text: "ICMP"; tint: Theme.ok; checked: UiTimeline.icmp; clicked => { UiTimeline.toggle-filter("icmp"); } } }
                        VerticalLayout { alignment: center; Chip { text: "IPv4"; tint: Theme.route; checked: UiTimeline.ipv4; clicked => { UiTimeline.toggle-filter("ipv4"); } } }
                        VerticalLayout { alignment: center; Chip { text: @tr("Changes"); tint: Theme.accent; checked: UiTimeline.edits; clicked => { UiTimeline.toggle-filter("edits"); } } }
                        VerticalLayout { alignment: center; Chip { text: @tr("Simulator"); tint: Theme.guard; checked: UiTimeline.simulator; clicked => { UiTimeline.toggle-filter("simulator"); } } }
                        VerticalLayout { alignment: center; Chip { text: @tr("Problems"); tint: Theme.drop; checked: UiTimeline.problems; clicked => { UiTimeline.toggle-filter("problems"); } } }
                        VerticalLayout {
                            alignment: center;
                            Chip {
                                text: UiTimeline.device-name == "" ? @tr("Selected device") : UiTimeline.device-name;
                                tint: Theme.link;
                                checked: UiTimeline.device-only;
                                clicked => { UiTimeline.toggle-filter("device"); }
                            }
                        }
                    }
                }
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 0;
            width: root.list-width;
            spacing: 4px;
            Rectangle {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: @tr("Event list");
                PixelFrame { width: 100%; height: 100%; unit: UiSprites.unit / 2; shadow: false; fill: Theme.sunken; border: Theme.edge; }
                // ListView only instantiates the visible rows.
                event-list := ListView {
                    x: 2px; y: 2px; width: parent.width - 14px; height: parent.height - 4px;
                    vertical-scrollbar-policy: always-off;
                    // The virtualized content height settles only after layout,
                    // so a new last row can be revealed only once it has grown.
                    changed content-height => { if UiTimeline.follow { root.reveal(UiTimeline.reveal-row); } }
                    for event[row] in UiTimeline.events: Rectangle {
                        height: root.row-height;
                        Rectangle {
                            x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                            background: UiTimeline.selected == event.index ? Theme.accent.chip : event-touch.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 10px;
                                Text {
                                    text: event.time; width: 76px; vertical-alignment: center;
                                    color: UiTimeline.selected == event.index ? Theme.accent.chip-ink : Theme.muted;
                                    font-family: Type.mono; font-size: Type.small;
                                }
                                // A narrow list keeps the time and what happened.
                                if root.list-width >= 300px: Text {
                                    text: event.protocol == "EDIT" ? @tr("CHANGE") : event.protocol;
                                    color: UiTimeline.selected == event.index ? Theme.accent.chip-ink : Theme.protocol(event.protocol).text;
                                    font-family: Type.ui; font-size: Type.small; font-weight: 600; width: 72px; vertical-alignment: center;
                                }
                                Text {
                                    text: event.summary;
                                    color: UiTimeline.selected == event.index ? Theme.accent.chip-ink : event.problem ? Theme.drop.text : Theme.ink;
                                    font-size: Type.small; overflow: elide; vertical-alignment: center;
                                }
                            }
                        }
                        accessible-role: button;
                        accessible-label: event.protocol + ": " + event.summary;
                        accessible-action-default => { UiTimeline.select(event.index); }
                        forward-focus: event-focus;
                        event-focus := FocusScope {
                            focus-on-tab-navigation: true;
                            key-pressed(e) => {
                                if e.text == " " || e.text == "\n" { UiTimeline.select(event.index); return accept; }
                                return reject;
                            }
                        }
                        event-touch := TouchArea { mouse-cursor: pointer; clicked => { event-focus.focus(); UiTimeline.select(event.index); } }
                    }
                }
                ScrollBar {
                    x: parent.width - self.width - 2px; y: 2px; height: parent.height - 4px;
                    offset <=> event-list.content-y;
                    content: event-list.content-height;
                    page: event-list.visible-height;
                }
                if UiTimeline.events.length == 0: Text {
                    width: parent.width - 32px;
                    text: UiTimeline.total == 0 ? @tr("The next experiment starts with a ping. Events will appear here.")
                        : @tr("No event matches the filters.");
                    color: Theme.muted; font-size: Type.small; wrap: word-wrap;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 6px;
            Tabs { titles: [@tr("Why"), @tr("Frame")]; current <=> UiTimeline.tab; }
            if UiTimeline.tab == 0: WhyView { vertical-stretch: 1; }
            if UiTimeline.tab == 1: Rectangle {
                vertical-stretch: 1;
                clip: true;
                PixelFrame { width: 100%; height: 100%; unit: UiSprites.unit / 2; shadow: false; fill: Theme.sunken; border: Theme.edge; }
                FrameView { x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px; }
            }
        }
    }
}
}
